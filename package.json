{
  "name": "lucerna",
  "version": "0.0.1",
  "description": "Lucerna: assistente de IA em painel lateral",
  "scripts": {
    "test": "vitest run",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/icons.mjs",
    "api-check": "node scripts/api-check.mjs",
    "test-pages": "node scripts/serve-test-pages.mjs",
    "build:e2e": "wxt build --mode e2e",
    "e2e": "wxt build --mode e2e && playwright test"
  },
  "type": "module",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "private": "true"
}
